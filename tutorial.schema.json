{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://playwright-tut/tutorial.schema.json",
    "title": "Tutorial config",
    "description": "Declarative click-path that drives a website with Playwright and renders an annotated PDF tutorial.",
    "type": "object",
    "required": ["name", "start_url", "steps"],
    "additionalProperties": false,
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable title of the tutorial."
        },
        "start_url": {
            "type": "string",
            "format": "uri",
            "description": "URL the browser opens before the first step."
        },
        "output": {
            "type": "string",
            "minLength": 1,
            "default": "tutorial.pdf",
            "description": "Path of the generated PDF."
        },
        "viewport": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "width": { "type": "integer", "minimum": 320 },
                "height": { "type": "integer", "minimum": 240 }
            },
            "required": ["width", "height"],
            "description": "Browser viewport size in pixels."
        },
        "headless": {
            "type": "boolean",
            "default": true,
            "description": "Run the browser without a visible window."
        },
        "steps": {
            "type": "array",
            "minItems": 1,
            "description": "Ordered list of tutorial steps.",
            "items": { "$ref": "#/definitions/step" }
        }
    },
    "definitions": {
        "step": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description"],
            "properties": {
                "description": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Caption shown on the screenshot for this step."
                },
                "action": {
                    "type": "string",
                    "enum": ["click", "fill", "press", "hover", "goto", "select"],
                    "default": "click",
                    "description": "Interaction to perform after the screenshot is captured."
                },
                "value": {
                    "type": "string",
                    "description": "Text to fill, key to press, or URL to navigate to (action-dependent)."
                },
                "locator": { "$ref": "#/definitions/locator" },
                "selector": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Legacy CSS selector. Prefer 'locator'. Treated as { \"css\": <value> }."
                },
                "highlight": {
                    "type": "boolean",
                    "default": true,
                    "description": "Draw the red highlight circle around the target element."
                },
                "status": {
                    "type": "string",
                    "enum": ["draft", "verified"],
                    "default": "draft",
                    "description": "Checkpoint state. 'verified' means the locator resolved on the live site."
                }
            },
            "allOf": [
                {
                    "description": "Non-goto steps need a way to find the element.",
                    "if": {
                        "properties": { "action": { "not": { "const": "goto" } } }
                    },
                    "then": {
                        "anyOf": [
                            { "required": ["locator"] },
                            { "required": ["selector"] }
                        ]
                    }
                },
                {
                    "description": "goto, fill, and select require a value.",
                    "if": {
                        "properties": { "action": { "enum": ["goto", "fill", "select"] } },
                        "required": ["action"]
                    },
                    "then": { "required": ["value"] }
                }
            ]
        },
        "locator": {
            "type": "object",
            "additionalProperties": false,
            "description": "A robust way to find an element. Provide exactly one strategy. Preference order when authoring: role > label > testId > text > css.",
            "minProperties": 1,
            "maxProperties": 2,
            "properties": {
                "role": {
                    "type": "string",
                    "description": "ARIA role, e.g. 'button', 'link', 'textbox'. Usually paired with 'name'."
                },
                "name": {
                    "type": "string",
                    "description": "Accessible name, used together with 'role'."
                },
                "label": {
                    "type": "string",
                    "description": "Associated <label> text of a form control."
                },
                "testId": {
                    "type": "string",
                    "description": "Value of the data-testid attribute."
                },
                "text": {
                    "type": "string",
                    "description": "Visible text content of the element."
                },
                "css": {
                    "type": "string",
                    "description": "CSS selector (least resilient; use as a last resort)."
                }
            }
        }
    }
}
